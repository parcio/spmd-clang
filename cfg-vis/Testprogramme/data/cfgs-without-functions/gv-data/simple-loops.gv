digraph G {
    "main14"[label=< <B>main14</B><BR/>int size;<BR/>int rank;<BR/>MPI_Init(&amp;argc, &amp;argv)<BR/>MPI_Comm_size(((MPI_Comm)((void *)&amp;(ompi_mpi_comm_world))), &amp;size)<BR/>MPI_Comm_rank(((MPI_Comm)((void *)&amp;(ompi_mpi_comm_world))), &amp;rank)<BR/>printf(\"%d: initialized %d processes\\n\", rank, size)<BR/>MPI_Status status;<BR/>int a = 1;<BR/>int b = 2;<BR/>int result_a;<BR/>int result_b;<BR/>>, shape=box]
