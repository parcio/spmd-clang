FROM --platform=linux/amd64 debian:12
USER root

RUN apt-get update --fix-missing && \
    apt-get install -y git cmake vim wget mpich python3 python3-pip && \
    apt-get autoremove -yq && apt-get clean -yq
    
ENV MPICH_CC=clang
ENV MPICH_CXX=clang++

RUN cd / && wget https://github.com/llvm/llvm-project/archive/refs/tags/llvmorg-22.1.8.tar.gz && \
    tar xvzf llvmorg-22.1.8.tar.gz && \
    mkdir /llvm-build

RUN cd /llvm-build && \
    cmake -DLLVM_ENABLE_PROJECTS="clang;openmp" -DLLVM_TARGETS_TO_BUILD=X86 -DCMAKE_BUILD_TYPE=RelWithDebInfo -DLLVM_OPTIMIZED_TABLEGEN=ON -DLLVM_ENABLE_ASSERTIONS=ON -DLLVM_ENABLE_DUMP=ON -DLLVM_ENABLE_PER_TARGET_RUNTIME_DIR=OFF -DBUILD_SHARED_LIBS=ON -DCMAKE_INSTALL_PREFIX=/llvm-install -G "Unix Makefiles" /llvm-project-llvmorg-22.1.8/llvm && \
    make -j$(nproc) && \
    make install

RUN rm -rf /llvm-project-llvmorg-22.1.8 && \
    rm -rf /llvmorg-22.1.8.tar.gz && \  
    rm -rf /llvm-build

ENV PATH="/llvm-install/bin:${PATH}"
ENV CC=clang
ENV CXX=clang++

RUN mkdir /spmd-clang
COPY ./ /spmd-clang/

RUN cd /spmd-clang && \
    rm -rf build && \
    mkdir -p build && \
    cd build && \
    cmake -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -DCT_LLVM_INSTALL_DIR=/llvm-install .. && \
    make -j$CPUS 
